        <entryLink id="7c1e-4b9d-2f83-6a05" name="Amber Fang" hidden="false" collective="false" import="true" targetId="3aae-98f2-7a3f-5b9a" type="selectionEntry"/>
        <entryLink id="9d2f-6a0b-3e75-8c14" name="Shard of Skoll" hidden="false" collective="false" import="true" targetId="932d-3051-b24f-dab4" type="selectionEntry"/>
